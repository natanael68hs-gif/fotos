{
  "rewrites": [
    { "source": "/install", "destination": "/install.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/authorize", "destination": "/authorize.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth-metadata" },
    { "source": "/oauth/authorize", "destination": "/api/oauth-authorize" },
    { "source": "/oauth/token", "destination": "/api/oauth-token" },
    { "source": "/oauth/register", "destination": "/api/oauth-register" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "functions": {
    "api/mcp.js": { "maxDuration": 60 },
    "api/device.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
