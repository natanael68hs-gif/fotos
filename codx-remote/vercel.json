{
  "rewrites": [
    { "source": "/install", "destination": "/install.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/authorize", "destination": "/authorize.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },

    { "source": "/api/backend-health", "destination": "https://codx-remote-api-zrider.onrender.com/health" },\n    { "source": "/api/backend-selftest", "destination": "https://codx-remote-api-zrider.onrender.com/selftest" },
    { "source": "/api/register", "destination": "https://codx-remote-api-zrider.onrender.com/api/register" },
    { "source": "/api/device", "destination": "https://codx-remote-api-zrider.onrender.com/api/device" },
    { "source": "/api/auth", "destination": "https://codx-remote-api-zrider.onrender.com/api/auth" },
    { "source": "/api/dashboard-action", "destination": "https://codx-remote-api-zrider.onrender.com/api/dashboard-action" },
    { "source": "/api/mcp", "destination": "https://codx-remote-api-zrider.onrender.com/api/mcp" },

    { "source": "/.well-known/oauth-protected-resource", "destination": "https://codx-remote-api-zrider.onrender.com/.well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "https://codx-remote-api-zrider.onrender.com/.well-known/oauth-authorization-server" },
    { "source": "/oauth/authorize", "destination": "https://codx-remote-api-zrider.onrender.com/oauth/authorize" },
    { "source": "/oauth/token", "destination": "https://codx-remote-api-zrider.onrender.com/oauth/token" },
    { "source": "/oauth/register", "destination": "https://codx-remote-api-zrider.onrender.com/oauth/register" },

    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
