{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codx-remote",
  "version": "0.7.2",
  "description": "Acesse computadores Windows autorizados pelo ChatGPT para trabalhar com arquivos, pastas, PowerShell e processos.",
  "author": {
    "name": "Codx Remote",
    "url": "https://codx-remote.onrender.com"
  },
  "homepage": "https://codx-remote.onrender.com",
  "repository": "https://github.com/natanael68hs-gif/fotos/tree/main/codx-remote",
  "keywords": ["remote", "windows", "mcp", "files", "terminal", "powershell"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Codx Remote",
        "shortDescription": "Acesse seu PC pelo chat",
        "longDescription": "Conecte seu computador Windows autorizado ao ChatGPT e trabalhe com arquivos, pastas, PowerShell, informações do sistema e processos por meio do Codx Remote.",
        "developerName": "Codx Remote",
        "category": "Developer Tools",
        "capabilities": ["Read", "Write", "Actions"],
        "websiteURL": "https://codx-remote.onrender.com",
        "privacyPolicyURL": "https://codx-remote.onrender.com/privacy",
        "termsOfServiceURL": "https://codx-remote.onrender.com/terms",
        "defaultPrompt": [
          "Liste meus dispositivos Codx Remote conectados.",
          "Mostre as pastas do meu computador.",
          "Leia um arquivo do meu computador."
        ],
        "brandColor": "#0B0F16",
        "logo": "./assets/codx-logo.svg",
        "composerIcon": "./assets/codx-logo.svg"
      }
    }
  }
}
